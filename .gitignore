# ==========================================
# .gitignore para el Proyecto de Inventario
# ==========================================

# 1. Maven y compilación (Muy importante)
target/
build/
dist/
*.class

# 2. Ejecutables generados por jpackage (La carpeta de Óscar)
SistemaInventario/
*.exe
*.msi
*.dmg

# 3. Archivos de configuración con credenciales (NUNCA subir)
src/main/resources/config.properties
.env

# 4. Configuración de NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/

# 5. Configuración de otros editores (IntelliJ, VS Code, Eclipse)
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# 6. Archivos del sistema operativo
.DS_Store
Thumbs.db

# 7. Archivos comprimidos (por si acaso)
*.zip
*.rar
